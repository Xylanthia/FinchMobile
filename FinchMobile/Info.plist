<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Finch</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>3.2</string>
	<key>CFBundleVersion</key>
	<string>43</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Finch continuously scans for BLE devices to provide live radar, filtering, and forensic export — including while the app is in the background during authorized assessments.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Finch scans nearby BLE advertisers and may connect to enumerate GATT for authorized IoT assessment.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Finch uses your iPhone location to geotag collected observations and exports with GPS accuracy and timestamps, and to center the live proximity map.</string>
	<key>NSCameraUsageDescription</key>
	<string>Finch uses the camera for AR overlays that place RF track labels in the real world during authorized assessments.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Finch may use the microphone only when you enable Acoustic fingerprinting in Research Mode for authorized lab scenarios.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Finch connects to your ARIA device on ARIA-Setup Wi-Fi and discovers devices on your local network. Allow access to view live ARIA data.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_hap._tcp</string>
		<string>_mqtt._tcp</string>
		<string>_rtsp._tcp</string>
		<string>_companion-link._tcp</string>
		<string>_printer._tcp</string>
		<string>_scanner._tcp</string>
		<string>_dacp._tcp</string>
		<string>_raop._tcp</string>
		<string>_finch-mesh._tcp</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Finch uses Face ID to secure your encrypted vault.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
